APP_NAME=SIMAK
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://simak.byethost31.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration for Byethost
DB_CONNECTION=mysql
DB_HOST=sql200.byethost.com
DB_PORT=3306
DB_DATABASE=b31_simakdb
DB_USERNAME=b31_simakuser
DB_PASSWORD=your_password_here

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Security
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
