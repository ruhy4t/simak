APP_NAME=SIMAK
APP_VERSION=2.7.3
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TEMP_UPLOAD_TTL_HOURS=168
SLOW_REQUEST_MS=1000
SLOW_QUERY_MS=250
REQUEST_METRICS_SAMPLE_RATE=0.1

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simak
DB_USERNAME=root
DB_PASSWORD=your_password_here

BROADCAST_DRIVER=log
# Use "database" after migrations are applied for cache shared by all instances.
# "file" remains suitable for a single persistent server.
CACHE_STORE=database
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Backblaze B2 / S3-compatible storage
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_REGION=us-west-004
B2_BUCKET=
B2_ENDPOINT=
B2_SIZE_LIMIT=10737418240

# Status Sistem (bytes). Default database quota: 1 GiB.
DB_SIZE_LIMIT=1073741824
SYSTEM_STATUS_CACHE_SECONDS=300

# Security
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
